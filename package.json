{
  "name": "date_tools",
  "version": "0.3.64",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run --dir tests",
    "test:e2e": "node scripts/run-browser-tests.mjs",
    "test:quality": "npm run test && npm run test:e2e",
    "test:rules:spec": "vitest run --dir emulator-tests",
    "test:rules": "node scripts/run-firestore-rules-tests.mjs",
    "health:check": "node scripts/health-check.mjs",
    "health:production": "node scripts/post-deploy-health.mjs",
    "quality:local": "node scripts/run-quality-gate.mjs",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@marsidev/react-turnstile": "^1.5.3",
    "@opennextjs/cloudflare": "^1.19.11",
    "firebase": "^12.14.0",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.121.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.4"
  }
}
